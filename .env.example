# OpenRouter API key (required for model query scripts)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Path to the paper's public code repository (required for data processing scripts)
# Only needed if re-running data processing from raw paper data
PAPER_DATA_DIR=/path/to/propaganda_llm_gh/code_public

# Path to propaganda corpus on HPC (only needed for extract_contamination_examples.py)
# PROPAGANDA_DATA_DIR=/scratch/your_user/propaganda_llm
